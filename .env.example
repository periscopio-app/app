# ==============================================================================
# PERISCÓPIO SAÚDE - CONFIGURAÇÃO DE AMBIENTE (.env.example)
# ==============================================================================

# --- Database (Neon - PostgreSQL) ---
DATABASE_URL=postgresql://neondb_owner:senha@ep-exemplo-pooler.c-2.sa-east-1.aws.neon.tech/neondb?sslmode=require

# --- Storage & Buckets (Supabase Storage) ---
SUPABASE_URL=https://rnaivkktezcjttjmtznn.supabase.co
SUPABASE_PROJECT_REF=rnaivkktezcjttjmtznn
SUPABASE_BUCKET=periscopio-uploads
SUPABASE_ANON_KEY=sua_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_secret_key
NEXT_PUBLIC_SUPABASE_URL=https://rnaivkktezcjttjmtznn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_public_key

# --- Auth (Neon Auth - Managed Better Auth) ---
NEON_AUTH_URL=https://ep-green-sun-b6elixxo.neonauth.c-2.sa-east-1.aws.neon.tech/neondb/auth
BETTER_AUTH_URL=https://ep-green-sun-b6elixxo.neonauth.c-2.sa-east-1.aws.neon.tech/neondb/auth
BETTER_AUTH_SECRET=sua_chave_secreta_aqui
BETTER_AUTH_JWKS_URL=https://ep-green-sun-b6elixxo.neonauth.c-2.sa-east-1.aws.neon.tech/neondb/auth/.well-known/jwks.json
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# --- URLs de Aplicação & CORS ---
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,https://seuapp.vercel.app

# --- Email (Resend) ---
RESEND_API_KEY=re_sua_api_key
RESEND_FROM_EMAIL=equipe@projetoperiscopio.com.br

# --- Backend API (Fastify / Render) ---
PORT=3001
NODE_ENV=development

# --- Frontend Web (Next.js / Vercel) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_NEON_AUTH_URL=/api/auth
NEXT_PUBLIC_BETTER_AUTH_URL=/api/auth
