# ==============================================================================
# PERISCÓPIO SAÚDE - CONFIGURAÇÃO DE AMBIENTE (.env.example)
# ==============================================================================

# --- Database (Neon - PostgreSQL) ---
DATABASE_URL=postgresql://neondb_owner:senha@ep-exemplo-pooler.c-2.sa-east-1.aws.neon.tech/neondb?sslmode=require

# --- Storage & Buckets (Supabase Storage) ---
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_PROJECT_REF=SEU_PROJECT_REF
SUPABASE_BUCKET=periscopio-uploads
SUPABASE_ANON_KEY=sua_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_secret_key
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_public_key

# --- Auth (Neon Auth / Better Auth) ---
NEON_AUTH_URL=https://SEU_NEON_ENDPOINT.neonauth.sa-east-1.aws.neon.tech/neondb/auth
BETTER_AUTH_URL=https://SEU_NEON_ENDPOINT.neonauth.sa-east-1.aws.neon.tech/neondb/auth
BETTER_AUTH_SECRET=sua_chave_secreta_aqui_minimo_32_caracteres
BETTER_AUTH_JWKS_URL=https://SEU_NEON_ENDPOINT.neonauth.sa-east-1.aws.neon.tech/neondb/auth/.well-known/jwks.json
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# --- Google OAuth Credentials ---
GOOGLE_CLIENT_ID=seu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_google_client_secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=seu_google_client_id.apps.googleusercontent.com

# --- URLs de Aplicação & CORS ---
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,https://seuapp.vercel.app

# --- Email (Resend) ---
RESEND_API_KEY=re_sua_api_key
RESEND_FROM_EMAIL=equipe@projetoperiscopio.com.br

# --- Backend API (Fastify / Render) ---
PORT=3001
NODE_ENV=development

# --- Seed de Usuários Master (Backend / Render) ---
# Necessário para rodar pnpm seed:masters e criar/sincronizar os admins da plataforma
SEED_MASTER_1_EMAIL=admin1@seusite.com.br
SEED_MASTER_1_NAME="Administrador Master 1"
SEED_MASTER_1_PASSWORD=senha_forte_do_admin_1_aqui

SEED_MASTER_2_EMAIL=admin2@seusite.com.br
SEED_MASTER_2_NAME="Administrador Master 2"
SEED_MASTER_2_PASSWORD=senha_forte_do_admin_2_aqui

# --- Frontend Web (Next.js / Vercel) ---
# O navegador sempre chama /api/* na mesma origem; o Next repassa para a API.
API_URL=http://localhost:3001


