# ==============================================================================
# PERISCÓPIO SAÚDE - CONFIGURAÇÃO DE AMBIENTE (.env.example)
# ==============================================================================

# --- Database (Neon - PostgreSQL) ---
DATABASE_URL=postgresql://neondb_owner:senha@ep-exemplo-pooler.c-2.sa-east-1.aws.neon.tech/neondb?sslmode=require

# --- Storage & Buckets (Supabase Storage) ---
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_PROJECT_REF=SEU_PROJECT_REF
SUPABASE_BUCKET=periscopio-uploads
# Fotos de perfil dos profissionais: bucket PÚBLICO e separado do clínico (criado sozinho na 1ª foto, se faltar).
SUPABASE_AVATAR_BUCKET=periscopio-avatars
SUPABASE_ANON_KEY=sua_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_secret_key
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_public_key

# --- Auth (Better Auth) ---
# BETTER_AUTH_URL: URL pública da API (ex: https://seu-app.onrender.com). Não usar endpoint neonauth (depreciado).
BETTER_AUTH_URL=https://sua-api.onrender.com
# Gere com: openssl rand -hex 32. Obrigatório em staging e produção.
BETTER_AUTH_SECRET=sua_chave_secreta_aqui_minimo_32_caracteres
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# --- URLs de Aplicação & CORS ---
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,https://seuapp.vercel.app

# --- Email (Resend) ---
RESEND_API_KEY=re_sua_api_key
RESEND_FROM_EMAIL=equipe@projetoperiscopio.com.br

# --- Backend API (Fastify / Render) ---
PORT=3001
NODE_ENV=development
# Gere uma chave exclusiva por ambiente: openssl rand -hex 32. Não use a mesma chave em staging e produção.
IDENTITY_VAULT_KEY=

# --- Seed de Usuários Master (Backend / Render) ---
# Necessário para rodar pnpm seed:masters e criar/sincronizar os admins da plataforma
SEED_MASTER_1_EMAIL=admin1@seusite.com.br
SEED_MASTER_1_NAME="Administrador Master 1"
SEED_MASTER_1_PASSWORD=senha_forte_do_admin_1_aqui

SEED_MASTER_2_EMAIL=admin2@seusite.com.br
SEED_MASTER_2_NAME="Administrador Master 2"
SEED_MASTER_2_PASSWORD=senha_forte_do_admin_2_aqui

# --- Configuração de demo / flags ---
# Desativa a janela terapêutica de 120 dias (canProceedToMedical) para ambientes de demo/staging.
# Em produção, mantenha ausente ou false.
DISABLE_THERAPEUTIC_WINDOW=false

# --- Frontend Web (Next.js / Vercel) ---
# O navegador sempre chama /api/* na mesma origem; o Next repassa para a API.
API_URL=http://localhost:3001



# --- Assistente do BI (apps/bi-rag, FastAPI) ---
# BI_RAG_TOKEN: senha compartilhada entre a API e o assistente (mesmo valor nos dois). Gere com: openssl rand -hex 32
BI_RAG_URL=http://localhost:8765
BI_RAG_TOKEN=
# Opcional (LLM desligado por padrão; veja apps/bi-rag/README.md): GROQ_API_KEY + BI_LLM_MODEL, ou GEMINI_API_KEY + BI_LLM_MODEL, ou ANTHROPIC_API_KEY.

# --- Mapa (Mapbox) ---
# Público, no build da Vercel (precisa de redeploy ao mudar):
NEXT_PUBLIC_MAPBOX_TOKEN=
# Servidor (API na Render), usado para geocodificar escolas:
MAPBOX_TOKEN=
