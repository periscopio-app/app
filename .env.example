# --- Database (Neon - PostgreSQL) ---
# Dica LGPD: Selecionar a região "AWS South America (São Paulo) / sa-east-1" no console do Neon.
# Pode usar a URL com pooler (recomendada) ou direta:
DATABASE_URL=postgresql://user:password@ep-sample-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
REDIS_URL=redis://localhost:6379

# --- Storage / CDN (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=periscopio-uploads
R2_PUBLIC_URL=

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=equipe@projetoperiscopio.com.br

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=gere-com-openssl-rand-base64-32
BETTER_AUTH_URL=https://your-neon-auth-url.neonauth.c-2.sa-east-1.aws.neon.tech/neondb/auth
BETTER_AUTH_JWKS_URL=https://your-neon-auth-url.neonauth.c-2.sa-east-1.aws.neon.tech/neondb/auth/.well-known/jwks.json




# --- API ---
PORT=3001
NODE_ENV=development

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3001
