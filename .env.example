# ==============================================================================
# PERISCÓPIO SAÚDE - CONFIGURAÇÃO DE AMBIENTE (.env.example)
# ==============================================================================

# --- Database (Neon - PostgreSQL) ---
DATABASE_URL=postgresql://neondb_owner:senha@ep-exemplo-pooler.c-2.sa-east-1.aws.neon.tech/neondb?sslmode=require

# --- Arquivos (laudos e fotos de perfil) ---
# Ficam no próprio banco (Neon): não há bucket nem variável de armazenamento externo.

# --- Auth (Better Auth) ---
# BETTER_AUTH_URL: URL pública da API (ex: https://seu-app.onrender.com). Não usar endpoint neonauth (depreciado).
BETTER_AUTH_URL=https://sua-api.onrender.com
# Gere com: openssl rand -hex 32. Obrigatório em staging e produção.
BETTER_AUTH_SECRET=sua_chave_secreta_aqui_minimo_32_caracteres
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# --- URLs de Aplicação & CORS ---
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,https://seuapp.vercel.app

# --- Email (Resend) ---
RESEND_API_KEY=re_sua_api_key
# Remetente único. O domínio precisa estar verificado no Resend (projetoperiscopio.com.br está). Padrão do código: o valor abaixo.
RESEND_FROM_EMAIL="Periscópio <equipe@projetoperiscopio.com.br>"

# --- Google Agenda + Meet (Board de experts) ---
# Cliente OAuth "Aplicativo da Web" do Google Cloud, com a Google Calendar API ativada e o escopo calendar.events.
# No JSON baixado do Google: client_id -> GOOGLE_CALENDAR_CLIENT_ID, client_secret -> GOOGLE_CALENDAR_CLIENT_SECRET.
GOOGLE_CALENDAR_CLIENT_ID=seu_client_id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=seu_client_secret
# Opcional. Padrão: APP_URL + /api/integrations/google/callback. Precisa estar IGUAL em "URIs de redirecionamento autorizados".
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
# Cifra o token do Google no banco. Gere com: openssl rand -hex 32. Uma chave por ambiente; trocar a chave exige reconectar o Google.
GOOGLE_TOKEN_ENC_KEY=gere_com_openssl_rand_hex_32

# --- Backend API (Fastify / Render) ---
PORT=3001
NODE_ENV=development
# Gere uma chave exclusiva por ambiente: openssl rand -hex 32. Não use a mesma chave em staging e produção.
IDENTITY_VAULT_KEY=

# --- Seed de Usuários Master (Backend / Render) ---
# Necessário para rodar pnpm seed:masters e criar/sincronizar os admins da plataforma
SEED_MASTER_1_EMAIL=admin1@seusite.com.br
SEED_MASTER_1_NAME="Administrador Master 1"
SEED_MASTER_1_PASSWORD_HASH=

SEED_MASTER_2_EMAIL=admin2@seusite.com.br
SEED_MASTER_2_NAME="Administrador Master 2"
SEED_MASTER_2_PASSWORD_HASH=
SUPERADMIN_EMAILS=admin2@seusite.com.br

# Execute manualmente no Shell do Render para criar os perfis demo, usando hash (sem senha em texto).
SEED_DEMO_EMAIL_DOMAIN=projetoperiscopio.com.br
SEED_DEMO_PASSWORD_HASH=

# --- Configuração de demo / flags ---
# Desativa a janela terapêutica de 120 dias (canProceedToMedical) para ambientes de demo/staging.
# Em produção, mantenha ausente ou false.
DISABLE_THERAPEUTIC_WINDOW=false

# --- Frontend Web (Next.js / Vercel) ---
# O navegador sempre chama /api/* na mesma origem; o Next repassa para a API.
API_URL=http://localhost:3001



# --- Assistente do BI (apps/bi-rag, FastAPI) ---
# BI_RAG_TOKEN: senha compartilhada entre a API e o assistente (mesmo valor nos dois). Gere com: openssl rand -hex 32
BI_RAG_URL=http://localhost:8765
BI_RAG_TOKEN=
# Opcional (LLM desligado por padrão; veja apps/bi-rag/README.md): GROQ_API_KEY + BI_LLM_MODEL, ou GEMINI_API_KEY + BI_LLM_MODEL, ou ANTHROPIC_API_KEY.

# --- Mapa (Mapbox) ---
# Público, no build da Vercel (precisa de redeploy ao mudar):
NEXT_PUBLIC_MAPBOX_TOKEN=
# Servidor (API na Render), usado para geocodificar escolas:
MAPBOX_TOKEN=

# --- Grafana Cloud (opcional: histórico no painel /admin/saude) ---
# Crie uma Cloud Access Policy só com metrics:read. Usuário = ID da instância Prometheus.
GRAFANA_PROM_URL=https://sua-instancia.grafana.net/api/prom
GRAFANA_PROM_USER=id_da_instancia_prometheus
GRAFANA_PROM_TOKEN=token_somente_leitura

# --- Grafana Cloud: envio das métricas pela API (OTLP) ---
# Forma padrão (a página Connections > OpenTelemetry do Grafana entrega estes valores prontos):
OTEL_SERVICE_NAME=periscopio-api
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-REGIAO.grafana.net/otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic base64_do_instanceid_e_token
# Alternativa com variáveis próprias:
# Connections > OpenTelemetry (OTLP). Usuário = OTLP Instance ID; token = access policy com metrics:write.
GRAFANA_OTLP_ENDPOINT=https://otlp-gateway-REGIAO.grafana.net/otlp
GRAFANA_OTLP_USER=id_da_instancia_otlp
GRAFANA_OTLP_TOKEN=token_com_metrics_write

# --- Custo estimado da IA no painel /admin/saude (opcional) ---
# Preço do provedor por 1 milhão de tokens (veja a tabela de preços do provedor e do modelo em uso). Sem isso, o painel mostra só tokens.
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
AI_PRICE_CURRENCY=US$
